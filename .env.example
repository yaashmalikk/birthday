# ==========================================
# Application Configuration & Secrets
# ==========================================
# Copy this file to .env.local to configure locally.
# DO NOT commit .env or .env.local with real keys to Git!

# (Optional) External API Endpoint & Secret Key
VITE_API_URL=
VITE_API_KEY=

# Base URL or path for media files (default: /media)
# If hosting media externally (e.g. Cloudinary, AWS S3, Google Cloud Storage), provide the full URL:
# VITE_MEDIA_BASE_URL=https://res.cloudinary.com/your-cloud/birthday
VITE_MEDIA_BASE_URL=/media

# Whether to load private memories from src/data/memories.private.json
# Set to 'true' for local personal builds, or 'false' for public demo mode
VITE_USE_PRIVATE_MEMORIES=true
